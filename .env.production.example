# Biến môi trường khi deploy lên Vercel (Project → Settings → Environment Variables, môi trường Production).
# Backend chạy ở máy chủ riêng (xem eco_backend/docs/08_DEPLOY.md).

# URL HTTPS của backend. Web quản trị gọi /api/* trên CHÍNH origin của nó, Next.js chuyển tiếp sang URL này từ phía server
# (app/api/[...path]/route.ts) — trình duyệt không bao giờ gọi chéo origin nên KHÔNG cần cấu hình CORS cho web quản trị.
BACKEND_URL=https://api.160.191.242.187.sslip.io

# Để TRỐNG để dùng proxy ở trên (khuyến nghị). Chỉ đặt URL backend khi muốn trình duyệt gọi thẳng (khi đó phải thêm origin của web này vào EF_CORS_ORIGINS ở backend).
NEXT_PUBLIC_API_URL=

# URL web bán hàng — nút "Web bán hàng" trên header (trống = ẩn nút).
NEXT_PUBLIC_STOREFRONT_URL=https://fitly-shop.vercel.app
