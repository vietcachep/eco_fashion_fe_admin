# URL backend NestJS mà Next.js proxy /api/* tới (server-side).
# Local (docker compose của eco_backend): http://localhost:4000
BACKEND_URL=http://localhost:4000

# Để trống → trình duyệt gọi same-origin /api/* qua proxy (khuyến nghị, không cần CORS).
# Đặt URL đầy đủ (vd http://localhost:4000) → trình duyệt gọi thẳng backend
# (backend phải có origin này trong EF_CORS_ORIGINS — mặc định đã có localhost:3001).
NEXT_PUBLIC_API_URL=

# URL OpenAPI spec cho `npm run api:spec` (backend bật EF_SWAGGER_ENABLED=true).
API_SPEC_URL=http://localhost:4000/docs/openapi.json

# Repo backend để `npm run perms:spec` chép catalog quyền (mặc định ../eco_backend).
BACKEND_REPO=../eco_backend

# URL web bán hàng — nút "Web bán hàng" trên header và "Xem trên web" ở chi tiết sản phẩm (trống = ẩn nút).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Chế độ dữ liệu: true = các màn hình quản trị dùng dữ liệu mẫu (mock), riêng Đăng nhập & Phân quyền chạy API thật; false = gọi backend cho tất cả
NEXT_PUBLIC_ENABLE_MOCK=true
